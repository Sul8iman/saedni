{
  "expo": {
    "name": "ساعدني",
    "slug": "saedni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saedni",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1AA87D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.saedni.app",
      "buildNumber": "3",
      "infoPlist": {
        "CFBundleDisplayName": "ساعدني",
        "NSLocationWhenInUseUsageDescription": "نحتاج موقعك لعرض الطلبات القريبة منك",
        "NSCameraUsageDescription": "نحتاج الكاميرا لرفع صور للطلبات",
        "NSPhotoLibraryUsageDescription": "نحتاج مكتبة الصور لرفع صور للطلبات"
      }
    },
    "android": {
      "package": "com.saedni.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1AA87D"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
