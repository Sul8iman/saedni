{
  "expo": {
    "name": "ساعدني",
    "slug": "saedni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saedni",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1AA87D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.saedni.app"
    },
    "android": {
      "package": "com.saedni.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1AA87D"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon.png",
      "name": "ساعدني",
      "shortName": "ساعدني",
      "lang": "ar",
      "description": "منصة المساعدة اليومية في عُمان",
      "themeColor": "#1AA87D",
      "backgroundColor": "#1AA87D",
      "display": "standalone",
      "orientation": "portrait",
      "scope": "/saedni-pwa/",
      "startUrl": "/saedni-pwa/"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/saedni-pwa"
    }
  }
}
